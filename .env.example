# Copy this file to .env and fill in the values. See README for how to get each key.

GEMINI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM observability (tracing, prompts, retrieval spans, eval scores). Sign up free at
# cloud.langfuse.com, create a project, then Settings -> API Keys to generate this pair.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# Optional. SEC EDGAR requires an identifying User-Agent (format: "AppName you@email.com")
# or it returns 403. Falls back to a generic default if left blank.
SEC_EDGAR_USER_AGENT=

# Optional. sentence-transformers model for embeddings. Defaults to intfloat/e5-base-v2.
EMBEDDING_MODEL=

# Optional. Gemini model for answer generation. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=
